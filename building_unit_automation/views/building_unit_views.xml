<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_building_unit_tree_inherit" model="ir.ui.view">
        <field name="name">building.unit.tree.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="itsys_real_estate.building_unit_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="in_invoice"/>
            </xpath>
            <xpath expr="//tree" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>
            <xpath expr="//tree" position="before">
                <header>
                    <button name="action_set_selected_units_sold" string="Set Selected to Sold" type="object" class="btn-primary"/>
                </header>
            </xpath>
            <xpath expr="//search" position="inside">
                <filter name="in_invoice" string="In Invoice" domain="[('in_invoice', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>